# Copy to config/prod.env and fill in. Used ONLY at build time:
#   flutter build appbundle --release --dart-define-from-file=config/prod.env
#   flutter build ipa       --release --dart-define-from-file=config/prod.env
#
# Never put ANTHROPIC_API_KEY or API_FOOTBALL_KEY here — those live in
# Supabase secrets (supabase secrets set ...) and are used by the
# claude-proxy / football-proxy Edge Functions.

APP_ENV=production
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-OR-PUBLISHABLE-KEY
VISION_BACKEND_URL=https://vision.YOUR-DOMAIN.com
PRIVACY_POLICY_URL=https://YOUR-DOMAIN.com/privacy
TERMS_OF_SERVICE_URL=https://YOUR-DOMAIN.com/terms

# Only after you hold written permission from the league / FA / clubs:
LICENSED_MEDIA=false
# Leave false unless you only import YouTube videos you own:
ENABLE_YOUTUBE_IMPORT=false

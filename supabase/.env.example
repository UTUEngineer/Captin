# Supabase Edge Functions — local env (copy to supabase/.env)
# Get values from Supabase Dashboard → Project Settings → Connect
# NEVER commit supabase/.env or the secret key.

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWKS_URL=https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# Flutter app uses SUPABASE_ANON_KEY — same value as SUPABASE_PUBLISHABLE_KEY

# ─────────────────────────────────────────────
# Captain App — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Supabase (required for Collaboration) ────
# Flutter: SUPABASE_ANON_KEY = Dashboard "publishable" key
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Edge Functions (supabase/.env — see supabase/.env.example):
# SUPABASE_PUBLISHABLE_KEY  (same value as SUPABASE_ANON_KEY)
# SUPABASE_SECRET_KEY       (service role — never commit)
# SUPABASE_JWKS_URL         https://YOUR_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# ── Anthropic (optional dev fallback for Scouting Reports) ─
# Keys entered in Settings are stored on device; this seeds dev builds only.
ANTHROPIC_API_KEY=sk-ant-...

# ── API-Football (optional dev fallback for Leagues) ───────
API_FOOTBALL_KEY=YOUR_KEY_HERE
API_FOOTBALL_HOST=v3.football.api-sports.io

# ── Vision Backend ─────────────────────────────
# Android emulator → 10.0.2.2 (localhost of host machine)
# Physical device  → IP of your machine, e.g. http://192.168.1.x:8000
# Production       → https://your-backend.com
VISION_BACKEND_URL=http://10.0.2.2:8000

# ── App Config (optional overrides) ───────────
APP_ENV=development
# APP_ENV=production

# ── How to use with Flutter ────────────────────
# Option A: copy this file to .env (bundled as a dev asset — see pubspec.yaml)
# Option B: pass at build time:
#
# flutter run \
#   --dart-define=SUPABASE_URL=https://xxx.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=eyJ... \
#   --dart-define=ANTHROPIC_API_KEY=sk-ant-... \
#   --dart-define=API_FOOTBALL_KEY=xxx \
#   --dart-define=VISION_BACKEND_URL=http://10.0.2.2:8000
#
# Legacy names still supported: FOOTBALL_API_KEY, VISION_API_BASE_URL
